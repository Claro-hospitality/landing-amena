# Copiar a .env.local. Apunta al Supabase de AMENA (el mismo proyecto que backoffice y
# portal): los eventos y reservaciones de este sitio viven en su schema `eventos`, y el
# backoffice los administra desde ahí. Los valores salen del Dashboard de Supabase del
# proyecto "Amena" → Project Settings → API Keys.
#
# Sin estas dos variables la app REVIENTA al importarse (src/lib/supabase.ts) y no renderiza
# ni la portada: main.tsx importa todas las páginas de forma estática.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Llave PÚBLICA de SinergyPay (la privada es un secret de la Edge Function reservar-pago,
# en amena-backend — nunca va en un VITE_*).
VITE_SINERGYPAY_PUBLIC_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
